;;;; Benchmark isolado de circuitos, sem renderização nem outras redes industriais.
(load (merge-pathnames "quicklisp/setup.lisp" (user-homedir-pathname)))
(pushnew (uiop:getcwd) asdf:*central-registry* :test #'equal)
(ql:quickload :asterion-assembly :silent t)
(asterion-assembly::preparar :safe-mode t)
(let ((mundo (antigonus:make-world)) (ticks 60))
  (dotimes (grupo 1000)
    (let* ((x (* (mod grupo 40) 12)) (y (* (floor grupo 40) 3))
           (sensor (antigonus:place-building mundo :circuit-sensor x y))
           (combinador (antigonus:place-building mundo :arithmetic-combinator (+ x 2) y))
           (a (antigonus:place-building mundo :signal-lamp (+ x 4) y))
           (b (antigonus:place-building mundo :signal-lamp (+ x 6) y))
           (c (antigonus:place-building mundo :programmable-alarm (+ x 8) y)))
      (antigonus:inventory-add (antigonus:building-inventory sensor) :iron-plate 50)
      (dolist (cor '(:red :green))
        (antigonus:connect-circuit mundo sensor combinador :port-b :input :color cor)
        (antigonus:connect-circuit mundo combinador a :port-a :output :color cor)
        (antigonus:connect-circuit mundo a b :color cor)
        (antigonus:connect-circuit mundo b c :color cor)
        (antigonus:connect-circuit mundo a c :color cor))))
  (let ((inicio (get-internal-real-time)))
    (antigonus:rebuild-circuit-networks mundo)
    (format t "~&GRAPH: ~,3F seconds~%"
            (/ (- (get-internal-real-time) inicio) internal-time-units-per-second)))
  (dotimes (i 5) (asterion-assembly::sistema-circuitos mundo))
  (let ((inicio (get-internal-real-time)))
    (dotimes (i ticks) (asterion-assembly::sistema-circuitos mundo))
    (let ((segundos (/ (- (get-internal-real-time) inicio) internal-time-units-per-second)))
      (format t "~&CIRCUITS: 5000 devices, 10000 wires, 1000 combinators; ~,2F ms/tick (~,1F UPS)~%"
              (* 1000 (/ segundos ticks)) (/ ticks segundos)))))
