(defpackage #:asterion-tests
  (:use #:cl #:antigonus)
  (:export #:run-all))
(in-package #:asterion-tests)

(defvar *executados* 0)
(defmacro verificar (condicao &optional (mensagem "verificação falhou"))
  `(progn (incf *executados*) (unless ,condicao (error "~A: ~S" ,mensagem ',condicao))))

(defun preparar () (asterion-assembly::preparar :safe-mode t))

(defun contar-item-transportador (predio item)
  (+ (inventory-count (building-inventory predio) item)
     (let ((pistas (getf (building-state predio) :belt-lanes)))
       (if pistas
           (loop for pista across pistas
                 sum (loop for i below (belt-lane-count pista)
                           when (eq item (aref (belt-lane-items pista) i))
                             sum (aref (belt-lane-stacks pista) i)))
           0))))

(defun teste-dsl-e-catalogo ()
  (preparar)
  (verificar (macro-function 'defitem) "DEFITEM deve ser macro")
  (verificar (macro-function 'defsystem) "DEFSYSTEM deve ser macro")
  (verificar (macro-function 'defanimation) "DEFANIMATION deve ser macro")
  (verificar (= 70 (hash-table-count antigonus::*itens*)))
  (verificar (= 90 (hash-table-count antigonus::*receitas*)))
  (verificar (= 52 (hash-table-count antigonus::*construcoes*)))
  (verificar (= 36 (hash-table-count antigonus::*tecnologias*)))
  (let ((indices (append (mapcar (lambda (p) (cons :v1 (cdr p)))
                                 asterion-assembly::*sprites-construcoes*)
                         (mapcar (lambda (p) (cons :v2 (cdr p)))
                                 asterion-assembly::*sprites-construcoes-v2*))))
    (verificar (= 52 (length indices)) "cada construção precisa de um sprite")
    (verificar (= 52 (length (remove-duplicates indices :test #'equal)))
               "sprites estáticos de construção não podem ser reutilizados"))
  (let ((indices (append (mapcar (lambda (p) (cons :v1 (cdr p)))
                                 asterion-assembly::*sprites-itens*)
                         (mapcar (lambda (p) (cons :v2 (cdr p)))
                                 asterion-assembly::*sprites-itens-v2*))))
    (verificar (= 70 (length indices)) "todo item precisa de ícone")
    (verificar (= 70 (length (remove-duplicates indices :test #'equal)))
               "ícones de itens não podem ser reutilizados")))

(defun teste-animacoes ()
  (reset-engine)
  (defanimation :test-loop :sheet :test :start 8 :frames 4 :fps 2)
  (defanimation :test-once :sheet :test :start 20 :frames 3 :fps 2 :loop nil)
  (verificar (= 8 (animation-frame :test-loop 0.0)))
  (verificar (= 11 (animation-frame :test-loop 1.5)))
  (verificar (= 8 (animation-frame :test-loop 2.0)) "animação deve fechar o loop")
  (verificar (= 22 (animation-frame :test-once 99.0)) "animação sem loop deve parar"))

(defun teste-transacao-inventario ()
  (let ((inv (make-hash-table :test #'equal)))
    (inventory-add inv :iron 10)
    (with-inventory-transaction (inv) (inventory-remove inv :iron 7) nil)
    (verificar (= 10 (inventory-count inv :iron)) "rollback do inventário")
    (with-inventory-transaction (inv) (inventory-remove inv :iron 4) t)
    (verificar (= 6 (inventory-count inv :iron)) "commit do inventário")))

(defun teste-determinismo ()
  (preparar)
  (let ((a (asterion-assembly:new-game :seed 4242 :difficulty :peaceful))
        (b (asterion-assembly:new-game :seed 4242 :difficulty :peaceful)))
    (dolist (w (list a b))
      (place-building w :miner -4 -4)
      (dotimes (i 450) (declare (ignore i)) (simulate-tick w)))
    (verificar (= (world-tick a) (world-tick b)))
    (verificar (= (world-pollution a) (world-pollution b)))
    (verificar (= (inventory-count (building-inventory (building-at a -4 -4)) :iron-ore)
                  (inventory-count (building-inventory (building-at b -4 -4)) :iron-ore)))))

(defun teste-producao-e-logistica ()
  (preparar)
  (let ((w (asterion-assembly:new-game :difficulty :peaceful)))
    (let ((forno (place-building w :stone-furnace 3 0 :recipe :smelt-iron)))
      (inventory-add (building-inventory forno) :iron-ore 2)
      (dotimes (i 50) (declare (ignore i)) (simulate-tick w))
      (verificar (= 1 (inventory-count (building-inventory forno) :iron-plate)))
      (verificar (= 1 (gethash :items-crafted (world-game-data w) 0))
                 "telemetria deve contar saídas realmente produzidas"))
    (let ((belt (place-building w :belt 1 0 :rotation 2)))
      (inventory-add (building-inventory belt) :iron-plate 1)
      (dotimes (i 8) (declare (ignore i)) (simulate-tick w))
      (verificar (> (inventory-count (asterion-assembly::inventario-jogador w) :iron-plate) 120)))))

(defun teste-item-no-braco ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (origem (place-building w :stone-furnace 10 10))
         (braco (place-building w :inserter 11 10 :rotation 0))
         (destino (place-building w :belt 12 10)))
    (inventory-add (building-inventory origem) :iron-plate 1)
    (dotimes (i 8) (declare (ignore i)) (simulate-tick w))
    (verificar (eq :iron-plate (getf (building-state braco) :carried-item))
               "braço deve registrar visualmente o item transferido")
    (verificar (= 1 (contar-item-transportador destino :iron-plate)))
    (verificar (plusp (gethash :items-moved (world-game-data w) 0))
               "telemetria deve contar itens transferidos")))

(defun teste-feedback-da-fabrica ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (minerador (place-building w :miner -5 -4))
         (saida-minerador (place-building w :belt -4 -4 :rotation 0))
         (continuidade (place-building w :belt -3 -4 :rotation 0))
         (ponta (place-building w :belt 7 7 :rotation 0)))
    (inventory-add (building-inventory ponta) :iron-ore 1)
    (dotimes (i 45) (declare (ignore i)) (simulate-tick w))
    (asterion-assembly::atualizar-alertas-fabrica w)
    (verificar (eq :blocked (asterion-assembly::estado-predio w ponta))
               "inspetor deve explicar uma saída de esteira bloqueada")
    (verificar (eq :working (asterion-assembly::estado-predio w minerador))
               "minerador alimentado sobre recurso deve aparecer operando")
    (verificar (plusp (gethash :items-mined (world-game-data w) 0))
               "telemetria deve contar recursos minerados")
    (verificar (plusp (+ (contar-item-transportador saida-minerador :iron-ore)
                         (contar-item-transportador continuidade :iron-ore)))
               "minerador deve descarregar diretamente na esteira frontal")
    (verificar (= 1 (gethash :blocked-output-count (world-game-data w) 0))
               "alerta deve resumir saídas bloqueadas")))

(defun teste-energia-sem-piscar ()
  "Três mineradores com esteiras não podem alternar ENABLED a cada tick."
  (preparar)
  (let ((w (asterion-assembly:new-game :difficulty :peaceful))
        (consumidores nil)
        (estavel t))
    (dolist (y '(-2 0 2))
      (push (place-building w :miner -5 y) consumidores)
      (push (place-building w :belt -4 y :rotation 0) consumidores))
    (dotimes (i 12)
      (declare (ignore i))
      (simulate-tick w)
      (unless (every (lambda (b)
                       (and (building-enabled b)
                            (getf (building-state b) :powered)))
                     consumidores)
        (setf estavel nil)))
    (verificar estavel "a rede inicial não deve alternar construções entre ligada e desligada")
    (verificar (= 50 (gethash :power-produced (world-game-data w)))
               "o núcleo inicial deve fornecer 50 MW")
    (verificar (= 21 (gethash :power-used (world-game-data w)))
               "a demanda deve incluir três mineradores e três esteiras")
    ;; Mesmo uma sobrecarga real deve produzir um conjunto estável de cargas
    ;; alimentadas, nunca a alternância clara/escura que causava o flicker.
    (dotimes (i 5)
      (push (place-building w :miner (+ 4 i) 4) consumidores))
    (simulate-tick w)
    (let ((estado (mapcar (lambda (b) (getf (building-state b) :powered)) consumidores))
          (sobrecarga-estavel t))
      (dotimes (i 12)
        (declare (ignore i))
        (simulate-tick w)
        (unless (equal estado
                       (mapcar (lambda (b) (getf (building-state b) :powered))
                               consumidores))
          (setf sobrecarga-estavel nil)))
      (verificar (member nil estado) "a sobrecarga deve deixar alguma carga sem energia")
      (verificar sobrecarga-estavel "a distribuição em sobrecarga deve permanecer estável")
      (verificar (every #'building-enabled consumidores)
                 "brownout não deve alterar a opção ENABLED das construções"))))

(defun teste-divisor-logistico ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (divisor (place-building w :splitter 10 10 :rotation 0))
         (frente (place-building w :belt 11 10 :rotation 0))
         (ramal (place-building w :belt 10 11 :rotation 1)))
    (inventory-add (building-inventory divisor) :iron-ore 4)
    (dotimes (i 32) (declare (ignore i)) (simulate-tick w))
    (verificar (= 2 (contar-item-transportador frente :iron-ore))
               "divisor deve alimentar a saída frontal")
    (verificar (= 2 (contar-item-transportador ramal :iron-ore))
               "divisor deve alternar de forma justa para o ramal")
    (verificar (= 0 (getf (building-state divisor) :next-output))
               "quatro transferências devem completar o ciclo determinístico")))

(defun teste-arrasto-e-desfazer ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (inventario (asterion-assembly::inventario-jogador w))
         (ferro-inicial (inventory-count inventario :iron-plate)))
    (setf asterion-assembly::*indice-selecao* 0
          asterion-assembly::*rotacao-construcao* 0)
    (verificar (= 0 (asterion-assembly::rotacao-entre-celulas '(2 . 2) '(3 . 2))))
    (verificar (= 1 (asterion-assembly::rotacao-entre-celulas '(2 . 2) '(2 . 3))))
    (asterion-assembly::construir-na-celula w 2 2)
    (asterion-assembly::construir-na-celula w 3 2)
    (verificar (= (- ferro-inicial 2) (inventory-count inventario :iron-plate))
               "linha construída deve consumir cada segmento")
    (verificar (building-at w 3 2))
    (asterion-assembly::desfazer-ultima-construcao w)
    (verificar (null (building-at w 3 2)) "undo deve remover somente o segmento mais recente")
    (verificar (building-at w 2 2) "undo deve preservar segmentos anteriores")
    (verificar (= (1- ferro-inicial) (inventory-count inventario :iron-plate))
               "undo recente deve devolver o custo integral")))

(defun contar-entidades (mundo predicado)
  (let ((quantidade 0))
    (map-entities (lambda (e) (when (funcall predicado e) (incf quantidade))) mundo)
    quantidade))

(defun teste-protagonista-ecossistema-e-vfx ()
  (preparar)
  (let ((w (asterion-assembly:new-game :seed 77 :difficulty :peaceful)))
    (verificar (= 1 (contar-entidades w (lambda (e) (eq (entity-kind e) :engineer))))
               "deve existir um protagonista humanoide")
    (verificar (= 0 (contar-entidades w (lambda (e) (eq (entity-kind e) :commander-drone))))
               "o drone não pode continuar como protagonista")
    (verificar (= 24 (contar-entidades
                      w (lambda (e) (member (entity-kind e)
                                            asterion-assembly::*fauna-passiva*))))
               "o mundo deve nascer com fauna passiva")
    ;; A atlas foi desenhada em oito vistas. Estes pontos cardeais impedem que
    ;; uma regressão volte a girar o corpo 3/4 de cabeça para baixo ou ao lado
    ;; oposto ao deslocamento.
    (let ((engenheiro nil))
      (map-entities (lambda (e)
                      (when (eq (entity-kind e) :engineer)
                        (setf engenheiro e)))
                    w)
      (dolist (caso `((0.0 6 :leste)
                      (,(coerce (/ pi 2) 'single-float) 0 :sul)
                      (,(- (coerce (/ pi 2) 'single-float)) 4 :norte)
                      (,(coerce pi 'single-float) 2 :oeste)))
        (setf (getf (entity-data engenheiro) :heading) (first caso))
        (verificar (= (second caso)
                      (asterion-assembly::indice-direcional-engenheiro engenheiro))
                   (format nil "vista do engenheiro deve apontar para ~A" (third caso)))))
    (let ((efeito (asterion-assembly::criar-efeito w :vfx-spark 2 2 :duracao 2)))
      (asterion-assembly::sistema-efeitos w)
      (verificar (= 1 (getf (entity-data efeito) :age)) "VFX deve avançar por tick")
      (asterion-assembly::sistema-efeitos w)
      (verificar (= 0 (contar-entidades w (lambda (e) (eq (entity-kind e) :vfx-spark))))
                 "VFX temporário deve ser removido"))))

(defun teste-arvore-tecnologica ()
