    (verificar (asterion-assembly::tecnologia-disponivel-p w :automation))
    (verificar (not (asterion-assembly::tecnologia-disponivel-p w :logistics))
               "pré-requisito deve bloquear o ramo")
    (verificar (not (asterion-assembly::construcao-desbloqueada-p w :assembler)))
    (place-building w :laboratory 3 3)
    (setf (gethash :research-progress (world-game-data w)) 19)
    (inventory-add (asterion-assembly::inventario-jogador w) :science-red 1)
    (dotimes (i 60) (declare (ignore i)) (simulate-tick w))
    (verificar (member :automation (world-research w)) "pesquisa ativa deve concluir")
    (verificar (asterion-assembly::construcao-desbloqueada-p w :assembler)
               "pesquisa deve liberar a construção")))

(defun teste-save-roundtrip ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :seed 999 :difficulty :explorer))
         (arquivo (merge-pathnames "asterion-test.save" (uiop:temporary-directory))))
    (place-building w :rail 7 9)
    (dotimes (i 31) (declare (ignore i)) (simulate-tick w))
    (unwind-protect
         (progn (save-game w arquivo)
                (let ((texto (uiop:read-file-string arquivo)))
                  (verificar (null (search "#." texto))
                             "save não pode conter avaliação de leitor"))
                (let ((r (load-game arquivo)))
                  (verificar (= 999 (world-seed r)))
                  (verificar (= 31 (world-tick r)))
                  (verificar (eq :rail (building-kind (building-at r 7 9))))
                  (verificar (= 120 (inventory-count
                                     (asterion-assembly::inventario-jogador r)
                                     :iron-plate)))))
      (when (probe-file arquivo) (delete-file arquivo)))))

(defun teste-pathfinding-e-trilhos ()
  (preparar)
  (let ((caminho (find-path '(0 . 0) '(4 . 0)
                            (lambda (p) (equal p '(2 . 0))))))
    (verificar (equal '(0 . 0) (first caminho)))
    (verificar (equal '(4 . 0) (car (last caminho))))
    (verificar (not (member '(2 . 0) caminho :test #'equal)))))

(defun teste-mod ()
  (preparar)
  (let* ((raiz (uiop:pathname-directory-pathname
                (asdf:system-source-file :asterion-assembly)))
         (mods (discover-mods (merge-pathnames "mods/" raiz))))
    (verificar (= 1 (length mods)))
    (load-mods mods)
    (verificar (find-item :luminous-bearing))
    (verificar (> (length (mod-fingerprint)) 0))))

(defun teste-desempenho-basico ()
  (preparar)
  (let ((w (asterion-assembly:new-game :difficulty :peaceful)))
    (loop for x from 1 to 50 do
      (loop for y from 1 to 40 do (place-building w :belt x y)))
    (let ((inicio (get-internal-real-time)))
      (dotimes (i 30) (declare (ignore i)) (simulate-tick w))
      (let ((segundos (/ (- (get-internal-real-time) inicio)
                         internal-time-units-per-second)))
        (verificar (< segundos 5.0) "2.000 construções devem simular 30 ticks em menos de 5 s")))))

(defun teste-fundacao-2-0 ()
  (preparar)
  (verificar (string= "2.0.0" +engine-version+))
  (verificar (= 2 +save-version+))
  (let ((w (make-world :seed 81 :worker-count 4)))
    (set-world-tile w -1 -33 17)
    (verificar (= 17 (world-tile w -1 -33)) "tile deve sobreviver em chunk negativo")
    (verificar (= -1 (chunk-x (find-chunk w -1 -33))))
    (verificar (= -2 (chunk-y (find-chunk w -1 -33))))
    (set-chunk-resource-count w 3 4 :iron-ore 12)
    (verificar (= 5 (deplete-resource w 3 4 :iron-ore 5)))
    (verificar (= 7 (chunk-resource-count w 3 4 :iron-ore)))
    (let ((resultados (run-deterministic-jobs '(5 4 3 2 1)
                                               (lambda (valor indice)
                                                 (+ valor indice))
                                               :workers 4)))
      (verificar (equal '(5 5 5 5 5) resultados)
                 "jobs devem retornar na ordem de entrada"))))

(defun teste-pistas-fluidos-energia-e-circuitos-2-0 ()
  (let ((pista (make-belt-lane :capacity 4)))
    (verificar (belt-lane-insert pista :iron :position 0))
    (verificar (belt-lane-insert pista :copper :position 5000))
    (advance-belt-lane pista 65535)
    (multiple-value-bind (item pilha pronto) (belt-lane-remove-front pista)
      (verificar pronto) (verificar (eq :copper item)) (verificar (= 1 pilha)))
    (verificar (= 1 (belt-lane-count pista))))
  (let ((fluido (make-fluid-network :id 1 :fluid :water :capacity 100.0)))
    (simulate-fluid-network fluido :inflow 60.0)
    (verificar (= 60.0 (fluid-network-volume fluido)))
    (verificar (= 0.6 (fluid-network-pressure fluido))))
  (let ((rede (make-circuit-network :id 1)))
    (circuit-write rede :iron 4)
    (circuit-write rede :iron 3 :mode :add)
    (verificar (= 7 (circuit-read rede :iron))))
  (let ((energia (make-power-network :id 1 :generation 10.0))
        (estado (make-array 2 :initial-element nil)))
    (allocate-power-network
     energia (list (list 2 0 6.0 (lambda (x) (setf (aref estado 1) x)))
                   (list 1 10 6.0 (lambda (x) (setf (aref estado 0) x)))))
    (verificar (aref estado 0) "carga prioritária deve receber energia")
    (verificar (null (aref estado 1)) "carga secundária deve permanecer estável em brownout")))

(defun teste-ferrovia-e-plantas-2-0 ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (grafo (world-rail-graph w))
         (a (add-rail-node grafo 0 0))
         (b (add-rail-node grafo 1 1))
         (aresta (add-rail-edge grafo a b :geometry :diagonal :block 7)))
    (declare (ignore aresta))
    (verificar (reserve-rail-block grafo 7 10))
    (verificar (null (reserve-rail-block grafo 7 11)))
    (verificar (= 1 (release-rail-blocks grafo 10)))
    (verificar (equal '((1 2)) (rail-deadlocks '((1 . 2) (2 . 1)))))
    (place-building w :belt 8 9 :rotation 1)
    (let ((planta (capture-blueprint w 8 9 8 9 :id :test)))
      (verificar (= 1 (length (blueprint-definition-entries planta))))
      (verificar (= 1 (length (apply-blueprint w planta 12 12))))
      (verificar (= 1 (length (world-ghosts w)))))))

(defun teste-integracao-asterion-2-0 ()
  (preparar)
  (let* ((w (asterion-assembly:new-game :difficulty :peaceful))
         (recurso (asterion-assembly::recurso-em w -5 -4))
         (antes (chunk-resource-count w -5 -4 recurso)))
    (deplete-resource w -5 -4 recurso 7)
    (verificar (= (- antes 7) (chunk-resource-count w -5 -4 recurso))
               "jazida materializada não pode renascer após extração")
    (let ((a (place-building w :pipe 10 10))
          (b (place-building w :pipe 11 10)))
      (inventory-add (building-inventory a) :water 40)
      (simulate-tick w)
      (let ((rede (gethash (getf (building-state a) :fluid-network)
                           (world-fluid-networks w))))
        (verificar (= 40.0 (fluid-network-volume rede)))
        (verificar (> (fluid-network-pressure rede) 0.0)))
      (inventory-add (building-inventory b) :oil 1)
      (simulate-tick w)
      (verificar (getf (building-state b) :fluid-conflict)
                 "rede deve bloquear mistura de fluidos"))
    (place-building w :circuit-sensor 15 15)
    (place-building w :arithmetic-combinator 16 15
                    :state '(:input-signal :items-moved :output-signal :halved
                             :operand 2))
    (setf (gethash :items-moved (world-game-data w)) 9)
    (simulate-tick w)
    (verificar (= 4 (circuit-read (gethash 0 (world-circuit-networks w)) :halved)))
    (let ((belt (place-building w :belt 20 20)))
      (inventory-add (building-inventory belt) :iron-ore 3)
      (dotimes (i 3) (declare (ignore i)) (simulate-tick w))
      (let ((arquivo #P"/tmp/asterion-v2-lanes.sexp"))
        (unwind-protect
             (progn
               (save-game w arquivo)
               (let* ((carregado (load-game arquivo))
                      (restaurado (building-at carregado 20 20))
                      (pistas (getf (building-state restaurado) :belt-lanes)))
                 (verificar (= 2 (length pistas)))
                 (verificar (= 3 (loop for pista across pistas
                                       sum (belt-lane-count pista))))))
          (when (probe-file arquivo) (delete-file arquivo)))))))

(defun teste-logistica-especializada-2-0 ()
  (preparar)
  (let ((w (asterion-assembly:new-game :difficulty :peaceful)))
    (let ((entrada (place-building w :underground-belt 30 30 :rotation 0))
          (saida (place-building w :underground-belt 34 30 :rotation 0))
          (destino (place-building w :belt 35 30 :rotation 0)))
      (declare (ignore saida))
      (inventory-add (building-inventory entrada) :iron-ore 1)
      (dotimes (i 9) (declare (ignore i)) (simulate-tick w))
      (verificar (= 1 (contar-item-transportador destino :iron-ore))
                 "esteira subterrânea deve atravessar até cinco células"))
    (let ((divisor (place-building w :filter-splitter 40 40 :rotation 0
                                  :state '(:filter :iron-ore)))
          (ferro (place-building w :belt 41 40 :rotation 0))
          (cobre (place-building w :belt 40 41 :rotation 1)))
      (inventory-add (building-inventory divisor) :iron-ore 1)
      (inventory-add (building-inventory divisor) :copper-ore 1)
      (dotimes (i 10) (declare (ignore i)) (simulate-tick w))
      (verificar (= 1 (contar-item-transportador ferro :iron-ore)))
      (verificar (= 1 (contar-item-transportador cobre :copper-ore))))
    (let ((origem (place-building w :stone-furnace 50 50))
          (braco (place-building w :stack-inserter 51 50 :rotation 0))
          (destino (place-building w :stone-furnace 52 50)))
      (declare (ignore braco))
      (inventory-add (building-inventory origem) :gear 4)
      (dotimes (i 8) (declare (ignore i)) (simulate-tick w))
      (verificar (= 4 (inventory-count (building-inventory destino) :gear))
                 "braço empilhador deve transferir quatro itens por ciclo"))))

(defun run-all ()
  (setf *executados* 0)
  (dolist (teste '(teste-dsl-e-catalogo teste-animacoes
                    teste-transacao-inventario teste-determinismo
                    teste-producao-e-logistica teste-item-no-braco
                    teste-feedback-da-fabrica teste-energia-sem-piscar teste-save-roundtrip
