(defun nome-controle (grupo codigo)
  (case grupo
    (:keyboard (nth (position codigo *teclas-configuraveis* :key #'sdl2:scancode-key-to-value)
                    (if (eq (current-language) :pt) *nomes-teclas-pt* *nomes-teclas-en*)))
    (:controller (aref (if (eq (current-language) :pt)
                          #("CONSTRUIR / CONFIRMAR" "REMOVER / CANCELAR" "DISPARO / COR" "CIRCUITOS" "ANTERIOR" "PROXIMO" "PAUSA" "VELOCIDADE" "INVENTARIO" "ANTERIOR / ABA" "PROXIMO / ABA" "GIRAR / CIMA" "RECEITA / BAIXO" "TECNOLOGIA / CAMPO" "CATALOGO / PALETA")
                          #("BUILD / CONFIRM" "REMOVE / CANCEL" "FIRE / COLOR" "CIRCUITS" "PREVIOUS" "NEXT" "PAUSE" "SPEED" "INVENTORY" "PREVIOUS / TAB" "NEXT / TAB" "ROTATE / UP" "RECIPE / DOWN" "TECHNOLOGY / FIELD" "CATALOG / PALETTE")) codigo))
    (:mouse (nth (1- codigo) (if (eq (current-language) :pt) '("CONSTRUIR / CONFIRMAR" "DISPARO" "REMOVER / CORTAR") '("BUILD / CONFIRM" "FIRE" "REMOVE / CUT"))))
